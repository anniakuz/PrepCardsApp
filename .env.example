DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

POSTGRES_DB=prepcards
POSTGRES_USER=prepcards
POSTGRES_PASSWORD=prepcards

# Contraseña de los usuarios de demostración (admin, mentor, estudiante)
DEMO_PASSWORD=demo-prepcards-2026

# Por defecto los emails se escriben en el log del backend y del worker
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Proveedor de IA: gemini o anthropic. Vacío usa el que tenga clave (Gemini primero)
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Mensajes que cada usuario puede enviar al chatbot, por día y por semana
CHATBOT_DAILY_LIMIT=10
CHATBOT_WEEKLY_LIMIT=30
