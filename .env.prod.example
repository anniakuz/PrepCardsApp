# Copia este archivo como .env en el servidor y rellena los valores

# Clave larga y aleatoria. Genera una con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0

# Con dominio, por ejemplo prepcards.midominio.com. Sin dominio, deja la IP pública de la instancia
DJANGO_ALLOWED_HOSTS=prepcards.midominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://prepcards.midominio.com
FRONTEND_URL=https://prepcards.midominio.com

# 1 solo si usas dominio con HTTPS. Sin dominio, déjalo en 0
DJANGO_HTTPS=1

# Con dominio escribe solo el dominio y Caddy pedirá el certificado HTTPS solo.
# Sin dominio, escribe :80 y se sirve por HTTP en la IP pública
SITE_ADDRESS=prepcards.midominio.com

POSTGRES_DB=prepcards
POSTGRES_USER=prepcards
POSTGRES_PASSWORD=

# Contraseña de los usuarios de demostración si ejecutas seed_demo a mano
DEMO_PASSWORD=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

CHATBOT_DAILY_LIMIT=10
CHATBOT_WEEKLY_LIMIT=30
